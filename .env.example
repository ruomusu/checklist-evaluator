# ================================================================
# 注意：本文件仅为模板，请复制为 .env 后填入真实值
# .env 已在 .gitignore 中排除，不会被提交到 Git 仓库
# ================================================================

# ========================
# LLM 提供者选择
# ========================
# 可选: openai | qwen | deepseek | custom
LLM_PROVIDER=openai

# ========================
# 各 LLM 提供者配置（只需填写你选用的那组）
# ========================

# --- OpenAI ---
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- 通义千问 (Qwen / DashScope) ---
# LLM_PROVIDER=qwen
QWEN_API_KEY=sk-your-qwen-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# --- DeepSeek ---
# LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- 自定义（兼容 OpenAI 接口的任意服务） ---
# LLM_PROVIDER=custom
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# --- 通用参数 ---
TEMPERATURE=0.2
MAX_TOKENS=4096

# ========================
# 知识库数据源配置
# ========================
# 提供者类型: local | api | database
KNOWLEDGE_PROVIDER=local

# --- 本地文件模式 ---
KNOWLEDGE_LOCAL_FILE=sample_knowledge_base.json

# --- API 模式 ---
# KNOWLEDGE_PROVIDER=api
KNOWLEDGE_API_URL=https://kb.internal.example.com
KNOWLEDGE_API_KEY=your-kb-api-key

# --- 数据库模式 ---
# KNOWLEDGE_PROVIDER=database
KNOWLEDGE_DB_URL=sqlite:///knowledge.db

# ========================
# 报告输出
# ========================
OUTPUT_DIR=./output

# ========================
# 搜索工具配置
# ========================

# Tool Calling 总开关（true 启用，false 禁用）
ENABLE_TOOL_CALLING=true

# --- 内部知识库检索（search_internal_kb） ---
# 本地 Mock 模式下的文件目录，放入 .md/.txt 文件即可
INTERNAL_KB_DIR=./internal_kb

# --- 外部 AWS 文档检索（search_aws_docs） ---
# 接入搜索 API（如 Tavily），留空则该工具返回空结果
SEARCH_API_KEY=
SEARCH_API_URL=
